# GOOGLE_PLACES_API_KEY: pulls your real Google reviews onto the homepage.
# Get it from Google Cloud Console (enable "Places API", then
# Credentials > Create Credentials > API Key). Requires billing enabled on
# the project, but this usage level is normally within Google's free tier.
# The Place ID is looked up automatically from your business name - you
# don't need to find it manually. Until this key is set, the Reviews
# section on the homepage simply doesn't render - no fake reviews shown.
GOOGLE_PLACES_API_KEY=""

# GOOGLE_PLACE_NAME_QUERY: optional override if the business name lookup
# ever needs adjusting. Defaults to "The Friedman Team by Kyle Friedman,
# Maryland" (confirmed from Kyle's real Google Maps listing) if not set.
GOOGLE_PLACE_NAME_QUERY=""

# LOFTY_API_KEY: Your Lofty API key - this connects the Listings page to your
# actual Bright MLS feed via Lofty's own API (no new vendor, no extra cost -
# you're already paying for this feed through your Lofty subscription).
# Get it from: Lofty -> Settings -> Integrations -> API -> Create API Key
# Treat this like a password - never commit it or share it outside .env.
LOFTY_API_KEY=""

# DEBUG_MLS: set to "true" temporarily to log one raw Lofty listing to the
# server console on first search, so you can confirm field names (photos,
# description, etc.) match what server/mlsClient.js expects. Turn back off
# once confirmed.
DEBUG_MLS="false"

# FUB_API_KEY: Your Follow Up Boss API key. Get this from Follow Up Boss:
# Admin -> API -> Create API Key. Every lead form on the site sends here.
# KEEP THIS SECRET - it is only read by server.js, never sent to the browser.
FUB_API_KEY="MY_FOLLOW_UP_BOSS_API_KEY"

# FUB_SOURCE: How leads will show up as "source" in Follow Up Boss.
# Set this to your real domain once you have one, e.g. "TheFriedmanTeam.com"
FUB_SOURCE="TheFriedmanTeam.com"

# PORT: Port the Express server (server.js) listens on. Most hosts (Render,
# Railway, Cloud Run) set this automatically - only change for local testing.
PORT=3001

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
